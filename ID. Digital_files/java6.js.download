var datasCalendario = [];
function desabilitarAlgunsDias(date) {
      var m = date.getMonth(), d = date.getDate(), y = date.getFullYear();
      if ( $.inArray( y+'-'+(m+1)+'-'+d, datasCalendario) == -1) {
        return [true];
      }
      return [false];
    }  

