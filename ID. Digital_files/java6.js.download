"showEasing": "swing",
"hideEasing": "linear",
"showMethod": "shake",
"hideMethod": "fadeOut"
,offset: {		x: 50,		y: 100	}
};
try {	toastr.warning(mensagem, null, opts);} catch(e) {}
		//tempo=40000;
		 
      
   
		break;}			
}	

