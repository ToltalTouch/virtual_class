function ConcatenaX(i)
{
var De=PegaObjeto(''+i);
var Para=PegaObjeto('Objetos');
var Botao=PegaObjeto('bVincular');
if (De.checked)
	{
	var p=Para.value;
	var s="";
	var d="I"+De.value+"|";
	var e="E"+De.value+"|";
	var i=p.indexOf(d);
	var c=p.indexOf(e);
	if ((i==-1)&&(c==-1))
		{
		s=p+d;
		}
	else 
		{
		s=p.substring(0,c);
	        c=c+e.length;
		s=s+p.substring(c);
		}
	}
else
	{
	var p=Para.value;
	var s="";
	var d="E"+De.value+"|";
	var i=p.indexOf(d);
	if (i==-1)
		{
		s=p+"E"+De.value+"|";
		}
	else 
		{
		s=p.substring(0,i);
	        i=i+d.length;
		s=s+p.substring(i);
		}
	}

Para.value=s;
var x=Para.value;
if (x.length>1)
   Botao.disabled="";
else
   Botao.disabled="";
}
