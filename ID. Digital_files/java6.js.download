function SomaValor(Condicao,De,Para)
{
var valor1=eval(Para.value);
var valor2=eval(De.value);

if (Condicao.checked) valor1=(valor1+valor2);
else valor1=(valor1-valor2);

Para.value=valor1;
}
function SomaValorTodos(Para)
{
var total=0;
var i=0;
var obj=PegaObjeto("VP"+i);
var cond=PegaObjeto("A"+i);
	if (cond.checked) {
		while (obj!=null) {
			total = total+eval(obj.value);	
			i++;
			obj = PegaObjeto("VP"+i);
		}
	}
Para.value=total;
}
function Soma(De,Para)
{
var valor=eval(Para.value);
if (De.checked)
	valor=(valor+1);
	else
	valor=(valor-1);
return valor;	
}
function Concatena(De,Para,Botao)
{
if (De.checked)
	{
	var p=Para.value;
	var s="";
	var d="I"+De.value+"|";
	var e="E"+De.value+"|";
	var i=p.indexOf(d);
	var c=p.indexOf(e);
	if ((i==-1)&&(c==-1))
		{
		s=p+d;
		}
	else 
		{
		s=p.substring(0,c);
	        c=c+e.length;
		s=s+p.substring(c);
		}
	}
else
	{
	var p=Para.value;
	var s="";
	var d="E"+De.value+"|";
	var i=p.indexOf(d);
	if (i==-1)
		{
		s=p+"E"+De.value+"|";
		}
	else 
		{
		s=p.substring(0,i);
	        i=i+d.length;
		s=s+p.substring(i);
		}
	}

Para.value=s;
var x=Para.value;
if (x.length>1)
   Botao.disabled="";
else
   Botao.disabled="";
}
